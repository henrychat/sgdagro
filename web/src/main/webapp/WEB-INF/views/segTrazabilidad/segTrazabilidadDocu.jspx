<jsp:root xmlns:tiles="http://tiles.apache.org/tags-tiles" version="2.0" xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:spring="http://www.springframework.org/tags" xmlns:form="http://www.springframework.org/tags/form">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <jsp:output omit-xml-declaration="yes"/>
    <jsp:scriptlet><![CDATA[response.setHeader("Cache-Control", "max-age=43200");]]></jsp:scriptlet>
    <spring:eval expression="@applicationProps['resources.version']" var="resourceVersion2"/>
  	<c:set var="resourceURL2" value="resources-${resourceVersion2}" scope="request"/>
  	
        <script languaje="javascript">
        
        jQuery(document).ready(function() {
        		fn_inicializaTrazabilidad('${buscarDocumentoEmiConsulBean.coAnnio}', '${fechaActual}');
                fn_construyeTablaVencimientoDetalleSegui();
                fn_construyeTablaVencimientoDetalleCuadradosSegui();
                
             //   fnVerLeyendaVencimientoEmi();
             
            });
        
     
        </script>

    <div class="ui-panel ui-corner-all" id="divEmiDocumentoAdminConsul" style="min-width: 1350px">
        <div class="ui-panel-titlebar ui-widget-header ui-corner-all">
            <span>SEGUIMIENTO DE DOCUMENTOS TRAZABILIDAD</span>
        </div>
        <div class="ui-panel-body">
            <input id="txtFechaActual" name="txtFechaActual" type="hidden" value="${fechaActual}"/>
            <input id="txtAnnioActual" name="txtAnnioActual" type="hidden" value="${annioActual}"/>
            <fieldset>
                <div class="btn-group btn-group-lg">
                  
                    <button title ="Ver Documento" class="btn btn-primary btn-lg" onclick="fn_verDocumentoLista();" type="button">
                        <span class="glyphicon glyphicon-list-alt"><jsp:text/></span> Ver Documento</button>
                    <button title ="Ver Documento Anexos - Referencias" class="btn btn-primary btn-lg" onclick="fn_verAnexoConsulRec();" type="button">
                        <span class="glyphicon glyphicon-paperclip"><jsp:text/></span> Ver Anexos</button>
                    <button title ="Seguimiento de Documentos" class="btn btn-primary btn-lg" onclick="fn_verSeguimientoEstEmi();" type="button">
                        <span class="glyphicon glyphicon-transfer"><jsp:text/></span> Seguimiento</button>
                    <div class="btn-group btn-group-lg">
                        <button title ="Exportar Consulta EXCEL" class="btn btn-primary" onclick="fu_generarReporteTrazabilidadXLS();" type="button">
                            <span class="glyphicon glyphicon-export"><jsp:text/></span> Exportar</button>
                        <button type="button" class="btn btn-primary btn-lg dropdown-toggle" data-toggle="dropdown">
                            <span class="caret"></span>&amp;nbsp;
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <ul id="ullsAbrirDocumento" class="dropdown-menu" role="menu">
<!--                             <li><a href="#" onclick="fu_generarReporteEmiSeguiEstPDF();" title ="Exportar Consulta PDF">Exportar PDF</a></li> -->
                            <li><a href="#" onclick="fu_generarReporteTrazabilidadXLS();" title ="Exportar Consulta Excel">Exportar Excel</a></li>
                        </ul>
                    </div>                         
                    <button title ="Salir Seguimiento de Estados de los Documentos Administrativos Emitidos" class="btn btn-primary btn-lg" onclick="cerrarPantalla();" type="button">
                        <span class="glyphicon glyphicon-log-out"><jsp:text/></span> Salir</button>
                </div>                    

            </fieldset>            
            <form:form modelAttribute="buscarDocumentoSeguiEstEmiBean">
                <input id="deDependencia" name="deDependencia" type="hidden" value="${deDepenciaActual}"/>    
                <form:hidden path="coDependencia"/>
                <form:hidden path="tipoBusqueda"/>    
                <form:hidden path="esFiltroFecha"/>  
                <form:hidden path="feEmiIni"/>  
                <form:hidden path="feEmiFin"/>  
                 <form:hidden path="incluyeFiltroFecha"  value="1"/> 
                              
                <table width="80%" >
               
                    <tr valign="top">
                        
                        <td width="80%">
                            <fieldset>
                                <legend>Busqueda</legend>
                                <table width="100%">
                                <tr>
                                 <td align="left">
                                           <span id="mensajeFecha"><strong> Incluir Filtro Fecha</strong></span>
                                            &amp;nbsp;
                                                                                  
                                            <a href="#" title="M&#225;s datos de B&#250;squeda" onclick="mostrarOcultarDivFecha();" class="btn-actdiv">
                                                <span id="spanDivBusquedaF" class="glyphicon glyphicon-collapse-down"><jsp:text/></span>
                                            </a>
                                  </td> 
                                  <td align="right">Nro Documento:</td>
                                   <td>
                                            <form:input path="busNumDoc" style="width: 200px;" maxlength="20"/>
                                    </td>
                                    <td> Nro Expediente:</td>
                                    <td colspan="2">
                                            <form:input path="busNumExpediente" style="width: 200px;" maxlength="20"/>
                                    </td>
                                </tr>
                                    <tr>
                                        <td colspan="3">
                                        
                                            <form:hidden path="coAnnio"/>
                                            
                                            <div id="fechaFiltro" class="cajaFechas">
                                                <div class="cajaIcono"><span class="glyphicon glyphicon-calendar fa fa-calendar"><jsp:text/></span></div>
                                                <div name="labelDate" class="cajaEtiqueta" style="text-align: center;width: 210px;"><jsp:text/></div>
                                                <div class="cajaTriangulo"><b class="caret"><jsp:text/></b></div>
                                            </div> 
                                                                               
                                        </td>                                    
                                        <td>Estado:</td>
                                        <td colspan="2">
                                            <form:select path="estadoDoc">
                                                <form:options items="${deEstadosList}" itemValue="coEst" itemLabel="deEst" />
                                            </form:select>
                                        </td>
                                                                              
                                    </tr>
                                    <tr>    
                                        <td>Unid. Orgánica:</td>
                                        <td colspan="2">
                                             <form:hidden path="busCodDepEmiRef"/> 
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="txtDepEmiteBus" name="txtDepEmiteBus" size="50" value=" [TODOS]" onkeyup="return fu_FiltrarTecladoCadenaFunParamGeneral(event, false, public_apenom, fn_buscaDependenciaRecepConsul, '');"/>
                                                        <span class="input-group-btn">
                                                            <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaDestinoTraza('busCodDepEmiRef','txtDepEmiteBus');"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                        </span>
                                                    </div>
                                        </td>  
                                        <td>Tipo Doc:</td>
                                        <td colspan="2">
                                            <form:select path="coTipoDocAdm" style="width:180px">
                                                <form:options items="${deTipoDocumentoList}" itemValue="coTipDoc" itemLabel="deTipDoc" />
                                            </form:select>
                                        </td>
                                        
                                    </tr>
                                     <tr>
                                        <td>Asunto:</td>
                                        <td colspan="2">
                                            <form:input path="busAsunto" style="width: 350px;" onkeypress="return fu_onKeyPressFiltrarTecladoCadena(event, false, public_letras)" maxlength="100"/>
                                        </td>
                                        <td align="right" colspan="2">
                                            <button title ="Filtrar documentos" class="btn btn-default btn-sm" onclick="changeTipoBusqTrazabilidad('1');" type="button">
                                                <span class="glyphicon glyphicon-filter"><jsp:text/></span> Buscar</button>
                                            <button title ="Limpiar datos de Filtro" class="btn btn-default btn-sm" onclick="fu_cleanSeguiTrazabilidad();" type="button">
                                                <span class="glyphicon glyphicon-remove"><jsp:text/></span></button>
                                        </td> 
                                         <td align="right" colspan="1">
                                            <a href="#" title="M&#225;s datos de Filtro" onclick="mostrarOcultarDivBusTrazabilidad();" class="btn-actdiv">
                                                <span id="spanDivFiltro" class="glyphicon glyphicon-collapse-down"><jsp:text/></span>
                                            </a>
                                        </td>                                        
                                    </tr>
                                </table>
                                <div id="divConfigFiltro" style="display:none;">
                                    <table width="80%">
                                        <tr>
                                            <td width="100px">Referencia. Origen:</td>
                                            <td>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="txtRefOrigen" name="txtRefOrigen" size="50" readonly="true" value="[TODOS]" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaReferenciaOrigenConsulEmiSegui();"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                    </span>
                                                </div>                                            
                                                <form:input path="coRefOrigen" type="hidden"/>
                                            </td>                                         
                                        </tr>
                                        <tr>
                                            <td width="100px">Remitente</td>
                                            <form:input path="coDepOrigen" type="hidden"/>
                                            <td>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="txtDepOrigen" name="txtDepOrigen" size="50" readonly="true" value="${deDepenciaActual}" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaDependenciaOrigenConsulEmiSeguiEst();"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                    </span>
                                                </div>                                            
                                            </td>
                                        </tr>

                                        <tr>                                    
                                            <td>Elaborado por:</td>
                                            <td>
                                                <form:input path="coEmpElaboro" type="hidden"/>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="txtElaboradoPor" name="txtElaboradoPor" size="50" readonly="true" value="[TODOS]" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaElaboradoPorConsulSeguiEstEmi();"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                    </span>
                                                </div>                                            
                                            </td>
                                        </tr>

                                        <tr>                                    
                                            <td>Destinatario:</td>
                                            <td>
                                                <form:input path="coDepDestino" type="hidden"/>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="txtDestinatario" name="txtDestinatario" size="50" readonly="true" value="[TODOS]"   />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaDestinoTraza('coDepDestino','txtDestinatario');"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                    </span>
                                                </div>                                            
                                            </td>
                                        </tr>
                                        <tr style="display:none">
                                            <td>Emp destino:</td>
                                            <td>
                                                <form:input path="coEmpDestino" type="hidden"/>
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="txtEmpDestino" name="txtEmpDestino" size="50" readonly="true" value="[TODOS]" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-default btn-xs-bus" type="button" onclick="fn_buscaEmpDestino();"><span class="glyphicon glyphicon-search"><jsp:text/></span></button>
                                                    </span>
                                                </div>                                            
                                            </td>
                                        </tr>
                                        
                                    </table>
                                </div>
                            </fieldset>                        
                        </td>
                    </tr>
                </table>                                
            </form:form>
            <fieldset>
                <legend>Detalle</legend>   
                <div id="divTblConsulDocumentoEmitido">
                    <jsp:directive.include file="tblSegTrazabilidad.jspx"/>
                </div>                
            </fieldset>
        </div>
    </div>
    <div id="divNewRecepDocumAdminConsul" style="display:none;">&amp;nbsp;</div>                                    
    <!-- redondo -->
    <div class="seleccionaFecha openCachito" style="display:none;">
        <div class="selectContent">
            <table id="tablaDetVencimientoCirculos">
            </table>
            <div style="width: 160px;">
                <button id="DPAceptar" type="button" class="btn btn-sm btn-success" style="margin-right: 5px;">Cerrar</button>
            </div>
        </div>
    </div>
    <!--Cuadrado-->
    <div id="divLeyendaVen" class="seleccionaFecha openCachito" style="display:none;">
        <div class="selectContent">
            <table id="tablaDetVencimientoCuadrados">
            </table>
        </div>
    </div>
</jsp:root>	