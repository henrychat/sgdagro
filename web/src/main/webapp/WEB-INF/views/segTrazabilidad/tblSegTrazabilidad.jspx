<jsp:root xmlns:tiles="http://tiles.apache.org/tags-tiles" version="2.0" xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:jsp="http://java.sun.com/JSP/Page" xmlns:spring="http://www.springframework.org/tags" xmlns:form="http://www.springframework.org/tags/form">    <jsp:directive.page contentType="text/html;charset=UTF-8"/>    <jsp:output omit-xml-declaration="yes"/>    <script languaje="javascript">jQuery(document).ready(function() {fu_eventoTablaTrazabilidadSegui();});</script>        <div style="color:#FF0000;"><b>${pMensaje}</b></div>	          <div class="ui-datatable-fixed">        <input type="hidden" id="txtpnuAnn" name="txtpnuAnn" value=""/>        <input type="hidden" id="txtpnuEmi" name="txtnuEmi" value=""/>        <input type="hidden" id="txtpnuDes" name="txtpnuDes" value="N"/>        <table id ="myTableFixed" class="display" width="100%">                 <thead>                <tr class="ui-state-default">                    <th style="display:none"/>                     <th style="display:none"/>                    <th style="display:none"/>                                        <th width="3%"/>                    <th width="3%">NRO</th>                    <th width="6%">FECHA EMISION</th>                    <th width="8%">BANDEJA</th>                     <th width="10%">N° EXPEDIENTE</th>                      <th width="7%">SIGLA ORIG. EXP</th>                     <th width="8%">N° DOCUMENTO</th>                     <th width="8%">TIPO DOCUMENTO</th>                    <th width="8%">REMITENTE</th>                    <th width="12%">DESTINATARIOS</th>                    <th width="6%">ESTADO</th>                    <th width="6%"> OF.MESA PARTES ORIGEN</th>                    <th width="8%">ASUNTO</th>                    <th width="7%">TIPO EMISIÓN</th>                </tr>            </thead>	 	 		            <tbody>                <c:forEach var="recepDocumAdm" items="${docTrabazabList}" varStatus="status">                    <tr class="gradeA" tabindex="0">                        <td style="display:none">${status.count}</td>                        <td style="display:none">${recepDocumAdm.nuAnn}</td>                        <td style="display:none">${recepDocumAdm.nuEmi}</td>                                                                                              <td>                                                      <c:choose>                                <c:when test='${recepDocumAdm.existeDoc eq "1"}'>                                    <button title ="Ver Documento" class="btn btn-default btn-xs" onclick="fn_verDocumento('${recepDocumAdm.nuAnn}', '${recepDocumAdm.nuEmi}');" type="button"><span class="glyphicon glyphicon-file"><jsp:text/></span></button>                                </c:when>                            </c:choose>										                                                         </td>                          <td>${recepDocumAdm.nro}</td>                         <td>${recepDocumAdm.fecEmision}</td>                        <td>${recepDocumAdm.bandeja}</td>                        <td>${recepDocumAdm.nuExpediente}</td>                        <td>${recepDocumAdm.siglaOri}</td>                         <td>${recepDocumAdm.nuDoc}</td>                        <td>${recepDocumAdm.tipoDocumento}</td>                         <td>${recepDocumAdm.remitente}</td>                        <td>${recepDocumAdm.destinos}</td>                        <td>${recepDocumAdm.estadoDocDes}</td>                       <td>${recepDocumAdm.deDependenciaMP} </td>                                                                        <td>${recepDocumAdm.asunto}</td>                        <td>${recepDocumAdm.deTiEmi}</td>                                                                                                                                           </tr>                </c:forEach>                        </tbody>			        </table>    </div>    <c:if test="${not empty msjEmision}">        <div class="alert alert-warning alert-dismissable" style="margin-bottom:0px;width:50%">            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">x</button>            <h4 style="margin-bottom:0px;">${msjEmision}</h4>        </div>                </c:if>            <div id="divflotante" class="divTip">&amp;nbsp;</div>    	      <script>        $(document).ready(function(){            var idTable="myTableFixed";               });    </script></jsp:root>	